{
  "name": "benchmark",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node build/index.js",
    "start:dev": "npx nodemon",
    "start:v2": "tsx ./src/index.ts",
    "start:v2:dev": "npx nodemon --exec npm run start:v2",
    "pseudo": "npm run build && node build/pseudonymous-bbs-signature.js",
    "pseudo:dev": "npx nodemon --exec npx ts-node ./src/pseudonymous-bbs-signature.ts",
    "impl:bbs-bls-signature-2020:dev": "npx nodemon --exec npx ts-node ./src/suite-implementations/bbs-bls-signature-2020.ts",
    "scratch": "tsx ./src/scratch.ts",
    "scratch:dev": "npx nodemon --exec npm run scratch",
    "scratch:jcan": "node src/resources/credentials/jcan/createCredentialFromPayload.js",
    "scratch:jcan:dev": "npx nodemon --exec npm run scratch:jcan"
  },
  "author": "Gertjan De Mulder (gertjan.demulder@ugent.be)",
  "license": "MIT",
  "devDependencies": {
    "@types/jsonld": "./@types/jsonld",
    "@types/jsonld-signatures": "./@types/jsonld-signatures",
    "@types/node": "^22.7.9",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@digitalbazaar/data-integrity": "^2.5.0",
    "@digitalbazaar/data-integrity-context": "^2.0.1",
    "@digitalbazaar/ecdsa-sd-2023-cryptosuite": "^3.4.1",
    "@digitalbazaar/ed25519-multikey": "^1.3.0",
    "@digitalbazaar/ed25519-signature-2020": "^5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.2.0",
    "@digitalcredentials/vc-data-model": "^2.0.0",
    "@mattrglobal/jsonld-signatures-bbs": "^1.2.0",
    "@zkp-ld/bls12381-key-pair": "^0.8.0",
    "@zkp-ld/jsonld-proofs": "^0.14.0",
    "json-tree-walker": "^1.1.4",
    "jsonld": "^8.3.2",
    "jsonld-document-loader": "^2.2.0",
    "jsonld-signatures": "7.0.0",
    "jsonld-signatures-v11-2-1": "npm:jsonld-signatures@^11.2.1",
    "jsonld-signatures-v9-0-0": "npm:jsonld-signatures@^9.0.0",
    "klona": "^2.0.6"
  }
}
